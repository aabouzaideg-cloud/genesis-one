# Capital.com API
CAPITAL_API_KEY=your_api_key_here
CAPITAL_PASSWORD=your_password_here
CAPITAL_IDENTIFIER=your_email_here

# News API (NewsAPI.org or similar)
NEWS_API_KEY=your_news_api_key_here

# Anthropic (for LLM sentiment gate)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Trading Mode: DEMO or LIVE
TRADING_MODE=DEMO

# Risk Settings (override defaults if needed)
MAX_RISK_PER_TRADE=0.01
MIN_MARGIN_PERCENT=350
